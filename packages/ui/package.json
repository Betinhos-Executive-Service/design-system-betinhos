{
  "name": "@betinhos-executive-service/ui",
  "version": "1.15.4",
  "description": "Componentes React do Design System Betinhos.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./error-logger": "./src/errorLogger.ts",
    "./error-logger.js": "./dist/error-logger.js",
    "./error-logger.iife.js": "./dist/error-logger.iife.js",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "files": [
    "src",
    "dist",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
