    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@betinhos-executive-service/tokens": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Betinhos-Executive-Service/design-system-betinhos.git",
    "directory": "packages/ui"
  },
